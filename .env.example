# ⚠️ NUNCA commit valores reais aqui. Copie para .env.local e preencha.
# .env.local está no .gitignore e jamais sobe para o GitHub.

# TMDB (públicas — safe de expor, mas prefira .env.local)
NEXT_PUBLIC_TMDB_API_KEY=
NEXT_PUBLIC_TMDB_READ_TOKEN=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 🔴 CRÍTICA: dá acesso admin TOTAL ao banco. Nunca subir para o GitHub.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
